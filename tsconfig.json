{
  "compilerOptions": {
    "jsx": "react",
    "target": "es6",
    "outDir": "lib",
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "config": [
        "src/types/config-shim"
      ]
    },
    "declaration": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "newLine": "LF"
  },
  "exclude": [
    "node_modules",
    "config",
    "lib"
  ]
}
